# Premisave auth-service: DEVELOPMENT values.
# For Docker Compose development nothing is required (docker-compose.yml has defaults). Copy this to .env
# (next to docker-compose.yml) only to try email and profile pictures. For every other setting see .env.example.
# Write values without quotes and without trailing spaces.

SPRING_PROFILES_ACTIVE=dev

# Same value as the messenger service. This is the messenger's own development default.
JWT_SECRET=eW91ci12ZXJ5LXNlY3VyZS1qd3Qtc2VjcmV0LWtleS0zMi1ieXRlcyE=
API_KEY=dev-internal-api-key

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

GMAIL_USERNAME=your-sender@gmail.com
GMAIL_PASSWORD=your-gmail-app-password
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
