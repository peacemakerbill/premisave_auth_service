# Premisave Auth Service — environment template
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is loaded automatically at startup (see PremisaveAuthServiceApplication,
# which uses dotenv-java) and every entry is copied into a system property
# before Spring reads application.yml, so these are the values that end up
# in ${VAR} there.
#
# This file (.env.example) is safe to commit: it holds no real secrets.
# .env itself must never be committed; confirm it's in .gitignore.
#
# No quotes, no trailing spaces, no spaces around "=".

# ── Core (required) ──
MONGODB_URI=mongodb://localhost:27017/premisave-auth
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=2592000000

# Generate with: openssl rand -hex 32
# Must be identical to INTERNAL_API_KEY in the wallet service (and any
# other Premisave service calling this one's /internal/** endpoints).
API_KEY=

# ── URLs ──
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# ── Mail (Gmail SMTP) — required for activation/reset emails ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
GMAIL_USERNAME=
# Google Account, Security, 2-Step Verification, App passwords
GMAIL_PASSWORD=
SUPPORT_EMAIL=

# ── Cloudinary (required) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── OAuth sign-in (all optional — leave blank to disable that provider) ──
# Google: console.cloud.google.com (APIs & Services, Credentials)
#         (comma-separate multiple client IDs: web-id,android-id,ios-id)
GOOGLE_CLIENT_ID=

# Facebook: developers.facebook.com (My Apps, Add App, Facebook Login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# GitHub: github.com/settings/developers (OAuth Apps, New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Rate limiting ──
RATE_LIMIT_REQUESTS_PER_MINUTE=20
